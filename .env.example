# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_USE_X_FORWARDED_PORT=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Database / Redis
DATABASE_URL=postgresql://postgres:postgres@db:5432/competitors_spy
REDIS_URL=redis://redis:6379/0

# Integrations
TELEGRAM_BOT_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_LLM_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.0-flash-lite
GOOGLE_LLM_MAX_CALLS_PER_USER_PER_DAY=10
TIKTOK_PROVIDER=stub
TIKTOK_PROVIDER_BASE_URL=
TIKTOK_PROVIDER_API_KEY=
TIKTOK_PROVIDER_API_SECRET=
TIKTOK_PROVIDER_ACCESS_TOKEN=
TIKTOK_APIFY_PROFILE_ACTOR_ID=clockworks/tiktok-profile-scraper
TIKTOK_APIFY_SEARCH_ACTOR_ID=clockworks/tiktok-user-search-scraper
TIKTOK_APIFY_RESULTS_PER_PROFILE=10
INSTAGRAM_PROVIDER=stub
INSTAGRAM_PROVIDER_BASE_URL=
INSTAGRAM_PROVIDER_API_KEY=
INSTAGRAM_PROVIDER_API_SECRET=
INSTAGRAM_PROVIDER_ACCESS_TOKEN=
INSTAGRAM_APIFY_PROFILE_ACTOR_ID=apify/instagram-profile-scraper
INSTAGRAM_APIFY_SEARCH_ACTOR_ID=iron-crawler/instagram-search-users

# Limits / defaults (MVP)
DEFAULT_TIMEZONE=Europe/Moscow
BASELINE_N=30
BASELINE_WINDOW_DAYS=30
YT_RECENT_N_FOR_METRICS=50
MAX_COMPETITORS_PER_PLATFORM=20
MIN_DELTA_VIEWS=500
MIN_VIEWS_END=1000
YT_MAX_SEARCH_CALLS_PER_SETUP=3
SETUP_RETRY_CACHE_TTL_SECONDS=300
SCHEDULE_RUNNING_STALE_MINUTES=60
