# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Database / Redis
DATABASE_URL=postgresql://postgres:postgres@db:5432/competitors_spy
REDIS_URL=redis://redis:6379/0

# Integrations
TELEGRAM_BOT_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_LLM_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.0-flash-lite
GOOGLE_LLM_MAX_CALLS_PER_USER_PER_DAY=10

# Limits / defaults (MVP)
DEFAULT_TIMEZONE=Europe/Moscow
BASELINE_N=30
BASELINE_WINDOW_DAYS=30
YT_RECENT_N_FOR_METRICS=15
MAX_COMPETITORS_YOUTUBE=20
MIN_DELTA_VIEWS=500
MIN_VIEWS_END=1000
YT_MAX_SEARCH_CALLS_PER_SETUP=3
SCHEDULE_RUNNING_STALE_MINUTES=60
